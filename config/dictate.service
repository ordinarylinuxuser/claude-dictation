# Installed by install.sh as ~/.config/systemd/user/dictate.service (@REPO@ = this repo's path).
[Unit]
Description=Claude Dictation (Whisper + Claude Haiku cleanup)
After=pipewire.service graphical-session.target
PartOf=graphical-session.target

[Service]
# Holds DICTATE_* settings, e.g. DICTATE_WHISPER_MODEL=large-v3-turbo
EnvironmentFile=-%h/.config/dictate/env
ExecStart=%h/.local/share/dictate/venv/bin/python -I @REPO@/dictate.py serve
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
